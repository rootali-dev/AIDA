### https://raw.github.com/github/gitignore/master/Rust.gitignore

# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk
# نادیده گرفتن یک پوشه خاص به اسم skills
.skills/
skills/

# نادیده گرفتن فایل‌های اسکیل با یک پسوند یا اسم خاص
*.skill
*.skill.json
my-skill-config.json

# نادیده گرفتن تنظیمات محیط اجرا و تست‌های محلی
*.local
.env